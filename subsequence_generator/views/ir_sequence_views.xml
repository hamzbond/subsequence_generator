<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_sequence_view_form_subsequence_generator" model="ir.ui.view">
        <field name="name">ir.sequence.view.form.subsequence.generator</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(action_ir_sequence_subsequence_wizard)d"
                            type="action"
                            string="Generate Subsequences"
                            class="btn-primary"
                            invisible="not use_date_range"/>
                </header>
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="alert alert-danger" role="alert" invisible="not has_overlapping_ranges">
                    This sequence has overlapping date ranges. Please review the ranges below.
                </div>
                <field name="has_overlapping_ranges" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='date_range_ids']/list" position="attributes">
                <attribute name="decoration-danger">is_overlapping</attribute>
            </xpath>
            <xpath expr="//field[@name='date_range_ids']/list/field[@name='number_next_actual']" position="after">
                <field name="is_overlapping" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
